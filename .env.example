# Token Depot. APP_ORIGIN controls the public site and API examples.
# Existing AIHUB_* and database identifiers are retained for compatibility.
DATABASE_URL="postgresql://aihub_app:YOUR_DATABASE_PASSWORD@127.0.0.1:55432/aihub?schema=public"
DATABASE_URL_TEST="postgresql://aihub_app:YOUR_DATABASE_PASSWORD@127.0.0.1:55432/aihub_auth_test?schema=public"
APP_ORIGIN="http://127.0.0.1:3000"
# Required in production. Use the exact public HTTPS origin, without a path.
SEO_INDEXING_ENABLED="false"
# Set true only for the confirmed public HTTPS origin after reviewing launch compliance.
# Public contact fields; leave empty until verified. Do not put credentials here.
SITE_OPERATOR_NAME=""
SITE_CONTACT_EMAIL=""

# Server pool budget is per application process; keep defaults until measured.
DATABASE_POOL_MAX="10"
DATABASE_POOL_TIMEOUT_MS="5000"
DATABASE_POOL_IDLE_MS="30000"
DATABASE_POOL_LIFETIME_SECONDS="1800"

# Server-only; configure privately in .env.local. Never use NEXT_PUBLIC_*.
# Current rollout: DeepSeek first. Leave the other provider keys empty.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_TIMEOUT_MS="90000"
# Additional trusted HTTPS origins for compatible channels, comma-separated.
# Defaults only allow each provider's official origin. Never allow internal hosts.
DEEPSEEK_ALLOWED_ORIGINS=""

# Reserved adapters; do not enable their models before configuring the provider.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TIMEOUT_MS="90000"
OPENAI_ALLOWED_ORIGINS=""
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
ANTHROPIC_TIMEOUT_MS="90000"
ANTHROPIC_ALLOWED_ORIGINS=""
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_TIMEOUT_MS="90000"
GEMINI_ALLOWED_ORIGINS=""
GATEWAY_REQUESTS_PER_MINUTE="60"
GATEWAY_DEFAULT_MAX_OUTPUT_TOKENS="1024"

# Channel defaults apply when a legacy model first receives a tracked route.
# Tune existing channels in /admin/providers. No backup is enabled automatically.
PROVIDER_CHANNEL_RPM="60"
PROVIDER_CHANNEL_TPM="200000"
PROVIDER_CHANNEL_CONCURRENCY="10"
PROVIDER_FAILURE_THRESHOLD="5"
ROUTER_MAX_RETRIES="2"
# Optional independent, compatible channel configuration (server-only).
# DEEPSEEK_BACKUP1_API_KEY=""
# DEEPSEEK_BACKUP1_BASE_URL="https://YOUR_COMPATIBLE_ENDPOINT/v1"
# Also include a backup endpoint's exact origin in DEEPSEEK_ALLOWED_ORIGINS.
# AIHUB_LOCAL_PROVIDER_TESTS is set only by isolated test fixtures. Do not set it
# in deployment: loopback upstreams require the isolated aihub_auth_test database.

# Redis protection is required for Gateway and sensitive mutations (fail closed).
# Use redis:// only for loopback; use rediss:// for hosted Redis, or Upstash HTTPS.
REDIS_URL="redis://:YOUR_REDIS_PASSWORD@127.0.0.1:56379/0"
REDIS_URL_TEST="redis://:YOUR_REDIS_PASSWORD@127.0.0.1:56379/15"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_NAMESPACE="aihub"
IP_HASH_SECRET="YOUR_RANDOM_SECRET_AT_LEAST_32_BYTES"
# Set only to a single-value IP header overwritten by a trusted reverse proxy.
# Leave empty for a shared conservative unknown-IP bucket; never trust arbitrary XFF.
TRUSTED_IP_HEADER=""
GATEWAY_USER_RPM="60"
GATEWAY_API_KEY_RPM="60"
GATEWAY_USER_TPM="200000"
GATEWAY_API_KEY_TPM="200000"
GATEWAY_IP_RPM="300"
GATEWAY_IP_TPM="1000000"
GATEWAY_ENDPOINT_RPM="12000"
GATEWAY_ENDPOINT_TPM="20000000"
GATEWAY_API_KEY_CONCURRENCY="10"
GATEWAY_INVALID_KEY_IP_RPM="10"
RISK_LOGIN_IP_RPM="10"
RISK_REGISTER_IP_RPM="5"
RISK_CREATE_API_KEY_IP_RPM="10"
RISK_CREATE_API_KEY_USER_RPM="10"
RISK_PAYMENT_CREATE_IP_RPM="10"
RISK_PAYMENT_CREATE_USER_RPM="10"
RISK_PASSWORD_RESET_IP_RPM="3"

# Server-only payment configuration. Without valid merchant configuration, keep disabled.
# Keys are read from private local files; never place PEM or API v3 keys in client code.
PAYMENTS_ENABLED="false"
PAYMENT_NOTIFY_ORIGIN=""
ALIPAY_APP_ID=""
ALIPAY_SELLER_ID=""
ALIPAY_PRIVATE_KEY_PATH=""
ALIPAY_PUBLIC_KEY_PATH=""
WECHAT_APP_ID=""
WECHAT_MCH_ID=""
WECHAT_CERT_SERIAL=""
WECHAT_PRIVATE_KEY_PATH=""
WECHAT_PUBLIC_KEY_ID=""
WECHAT_PUBLIC_KEY_PATH=""
WECHAT_API_V3_KEY_PATH=""
