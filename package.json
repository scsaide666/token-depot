{
  "name": "token-depot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/font-preloads.mjs --dev && prisma generate",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "prebuild": "node scripts/font-preloads.mjs && prisma generate",
    "build": "next build --webpack",
    "postbuild": "node scripts/font-preloads.mjs --verify",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "test:lint-security": "node scripts/test-eslint-security.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "test:auth": "tsx scripts/test-auth.ts",
    "test:api-keys": "node --conditions=react-server --import tsx scripts/test-api-keys.ts",
    "test:models": "tsx scripts/test-models.ts",
    "test:gateway": "tsx scripts/test-gateway.ts",
    "test:billing": "node --conditions=react-server --import tsx scripts/test-billing.ts",
    "test:dashboard": "node --conditions=react-server --import tsx scripts/test-dashboard.ts",
    "test:payments": "node --conditions=react-server --import tsx scripts/test-payments.ts",
    "test:payment-polling": "tsx scripts/test-payment-polling.ts",
    "smoke:gateway": "node --conditions=react-server --import tsx scripts/smoke-gateway.ts --live",
    "smoke:deepseek": "node --conditions=react-server --import tsx scripts/smoke-gateway.ts --live --deepseek",
    "smoke:playground": "node --conditions=react-server --import tsx scripts/smoke-gateway.ts --live --deepseek --playground",
    "configure:deepseek": "node --conditions=react-server --import tsx scripts/configure-deepseek.ts",
    "test": "npm run test:auth && npm run test:api-keys && npm run test:models && npm run test:gateway && npm run test:billing && npm run test:dashboard && npm run test:payments && npm run test:payment-polling && npm run test:risk && npm run test:admin && npm run test:providers && npm run test:routing && npm run test:streaming && npm run test:playground && npm run test:security && npm run test:performance && npm run test:recovery-batch && npm run test:seo",
    "redis:start": "node scripts/local-redis.mjs start",
    "redis:stop": "node scripts/local-redis.mjs stop",
    "redis:status": "node scripts/local-redis.mjs status",
    "test:risk": "node --conditions=react-server --import tsx scripts/test-risk.ts",
    "test:admin": "node --conditions=react-server --import tsx scripts/test-admin.ts",
    "test:providers": "node --conditions=react-server --import tsx scripts/test-providers.ts",
    "test:routing": "node --conditions=react-server --import tsx scripts/test-routing.ts",
    "test:streaming": "node --conditions=react-server --import tsx scripts/test-streaming.ts",
    "test:playground": "tsx scripts/test-playground-client.tsx && node --conditions=react-server --import tsx scripts/test-playground.ts",
    "security:audit": "node scripts/security-audit.mjs",
    "test:security": "node --conditions=react-server --import tsx scripts/test-security.ts",
    "test:performance": "node --conditions=react-server --import tsx scripts/test-performance.ts",
    "test:recovery-batch": "tsx scripts/test-recovery-batch.ts",
    "test:seo": "node --conditions=react-server --import tsx scripts/test-seo.ts",
    "test:home": "tsx scripts/test-home.tsx",
    "test:dashboard-ui": "tsx scripts/test-dashboard-ui.tsx",
    "test:core-ui": "tsx scripts/test-core-pages-ui.tsx",
    "test:interactions-ui": "tsx scripts/test-interactions-ui.tsx",
    "test:brand-ui": "tsx scripts/test-brand-ui.tsx",
    "test:responsive-ui": "tsx scripts/test-responsive-ui.tsx",
    "test:developer-ui": "tsx scripts/test-developer-ui.tsx",
    "test:ux-performance": "tsx scripts/test-ux-performance.tsx",
    "performance": "node --conditions=react-server --import tsx scripts/performance.ts",
    "wallet:recover": "node --conditions=react-server --import tsx scripts/recover-reservations.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "alipay-sdk": "4.14.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.4.0",
    "dotenv": "18.0.5",
    "geist": "1.7.2",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "redis": "6.3.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "undici": "8.11.2",
    "zod": "4.6.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.23.1",
    "urllib": "4.9.1",
    "@next/eslint-plugin-next@16.3.8": {
      "fast-glob": "$fast-glob"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "openai": "^7.31.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "fast-glob": "file:./tooling/eslint-glob"
  },
  "license": "MIT",
  "description": "An open-source AI API developer platform with a blue-and-white Geist interface.",
  "repository": {
    "type": "git",
    "url": "https://github.com/scsaide666/token-depot.git"
  },
  "bugs": {
    "url": "https://github.com/scsaide666/token-depot/issues"
  }
}
