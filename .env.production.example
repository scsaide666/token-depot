# Token Depot: non-secret Docker Compose inputs only. No public launch approval.
# .example is reserved. Replace only after domain ownership and filing review.
SITE_DOMAIN=token-depot.example
API_DOMAIN=api.token-depot.example
ACME_EMAIL=operator@example.com
# Use reviewed immutable repository@sha256:... references, never test-tools/latest.
APP_IMAGE=token-depot-app:REPLACE_WITH_REVIEWED_VERSION
TOOLS_IMAGE=token-depot-ops:REPLACE_WITH_REVIEWED_VERSION
CADDY_IMAGE=token-depot-caddy:REPLACE_WITH_REVIEWED_VERSION
APP_SECRET_FILE=./deploy/secrets/app.env
DB_PASSWORD_FILE=./deploy/secrets/db-password
APP_DB_PASSWORD_FILE=./deploy/secrets/app-db-password
REDIS_PASSWORD_FILE=./deploy/secrets/redis-password
PAYMENT_KEYS_DIR=./deploy/payment-keys
