# Export from your secret manager on the server; mounted as a Compose secret.
# Never commit, upload to chat, or bake the populated version into an image.
NODE_ENV=production
DATABASE_URL=postgresql://aihub:REPLACE_WITH_DB_HEX_PASSWORD@postgres:5432/aihub?schema=public
APP_ORIGIN=https://token-depot.example
SEO_INDEXING_ENABLED=false
SITE_OPERATOR_NAME=
SITE_CONTACT_EMAIL=
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_MS=5000
DATABASE_POOL_IDLE_MS=30000
DATABASE_POOL_LIFETIME_SECONDS=1800
REDIS_URL=redis://:REPLACE_WITH_REDIS_HEX_PASSWORD@127.0.0.1:6379/0
REDIS_NAMESPACE=aihub-production
IP_HASH_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
TRUSTED_IP_HEADER=x-aihub-client-ip
# Pre-launch: all provider keys remain unset until separately approved live tests.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=90000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PAYMENTS_ENABLED=false
PAYMENT_NOTIFY_ORIGIN=https://token-depot.example
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=/run/payment-keys/alipay-private.pem
ALIPAY_PUBLIC_KEY_PATH=/run/payment-keys/alipay-public.pem
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_CERT_SERIAL=
WECHAT_PRIVATE_KEY_PATH=/run/payment-keys/wechat-private.pem
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY_PATH=/run/payment-keys/wechat-public.pem
WECHAT_API_V3_KEY_PATH=/run/payment-keys/wechat-api-v3

