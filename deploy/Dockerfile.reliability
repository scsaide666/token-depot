# Test-only SDK runtime; never use this target as the production application.
ARG TEST_SOURCE_IMAGE=token-depot-reliability-test-tools:20261016
FROM ${TEST_SOURCE_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/token-depot-sdk \
    && /opt/token-depot-sdk/bin/python3 -m pip install --no-cache-dir -r scripts/requirements-sdk.txt
ENV PYTHON_TEST_EXECUTABLE=/opt/token-depot-sdk/bin/python3
ENV PYTHON_TEST_PATH=/opt/token-depot-sdk/lib/python3.11/site-packages
# Official signed Microsoft Debian repository; pinned test-only PowerShell.
USER root
RUN curl --fail --silent --show-error --location https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb -o /tmp/microsoft-repo.deb \
    && dpkg -i /tmp/microsoft-repo.deb && rm /tmp/microsoft-repo.deb \
    && apt-get update && apt-get install -y --no-install-recommends powershell=7.6.7-1.deb \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/curl /usr/local/bin/curl.exe \
    && ln -s /usr/bin/pwsh /usr/local/bin/powershell.exe
COPY --chown=node:node scripts/test-streaming.ts scripts/test-playground.ts ./scripts/
USER node
